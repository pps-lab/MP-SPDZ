# Create a wrapper module that includes encoder + pooler + dropout + classifier
import torch.nn as nn
class BertEncoderWithHead(nn.Module):
    def __init__(self, encoder, pooler, dropout, classifier, config):
        super().__init__()
        self.encoder = encoder
        self.pooler = pooler
        self.dropout = dropout
        self.classifier = classifier
        self.config = config  # Store config so layers_from_torch can access it

    def forward(self, hidden_states, attention_mask=None, head_mask=None,
                encoder_hidden_states=None, encoder_attention_mask=None,
                past_key_values=None, use_cache=None, output_attentions=False,
                output_hidden_states=False, return_dict=False):
        # Run encoder
        encoder_outputs = self.encoder(
            hidden_states,
            attention_mask=attention_mask,
            head_mask=head_mask,
            encoder_hidden_states=encoder_hidden_states,
            encoder_attention_mask=encoder_attention_mask,
            past_key_values=past_key_values,
            use_cache=use_cache,
            output_attentions=output_attentions,
            output_hidden_states=output_hidden_states,
            return_dict=return_dict,
        )
        sequence_output = encoder_outputs[0]
        pooled_output = self.pooler(sequence_output) if self.pooler is not None else None
        pooled_output = self.dropout(pooled_output)
        logits = self.classifier(pooled_output)
        return logits

bert_with_head = BertEncoderWithHead(model.bert.encoder, model.bert.pooler, model.dropout, model.classifier, model.config)

# Trace the combined model
layers = ml.layers_from_torch(bert_with_head, model_shape, input_via=0, batch_size=spdz_batch_size) # set batch size bigger?

print("MP-SPDZ layers", layers)

optimizer = ml.SGD(layers)


def layers_for_bertlayer(bert_layer, bert_layer_pt):
    # Warning: Take care here that the order is in the way the hook is called in the forward pass
    return [
        (bert_layer.multi_head_attention.dropout, bert_layer_pt.attention.self.dropout),
        (bert_layer.multi_head_attention.output, bert_layer_pt.attention.output),
        (bert_layer.multi_head_attention, bert_layer_pt.attention),

        (bert_layer.intermediate.dense, bert_layer_pt.intermediate.dense),
        # Skip activation layer - it's internal to intermediate and shares the same output
        # (bert_layer.intermediate.activation, bert_layer_pt.intermediate.intermediate_act_fn),
        (bert_layer.intermediate, bert_layer_pt.intermediate),

        (bert_layer.output.dense, bert_layer_pt.output.dense),
        (bert_layer.output.dropout, bert_layer_pt.output.dropout),
        (bert_layer.output.layer_norm, bert_layer_pt.output.LayerNorm),
        (bert_layer.output, bert_layer_pt.output),
        (bert_layer, bert_layer_pt),
    ]

layers_to_compare = [layers_for_bertlayer(l1, l2) for l1, l2 in zip(optimizer.layers[:-4], model.bert.encoder.layer)]
layers_to_compare = [x for xs in layers_to_compare for x in xs]
layers_to_compare.append((optimizer.layers[-4], model.bert.pooler))
# dropout
layers_to_compare.append((optimizer.layers[-3], model.dropout))
layers_to_compare.append((optimizer.layers[-2], model.classifier))

# activation_list = []
activation_map = {}
def get_activation(name):
    def hook(model, input, output):
        # Some layers return tuples, some return tensors directly
        if isinstance(output, tuple):
            actual_output = output[0]
        else:
            actual_output = output
        print(f"{name} Activation Input", input[0].shape, "shape", actual_output.shape)
        # activation_list.append((name, actual_output.detach()))
        activation_map[name] = actual_output.detach()
    return hook

if compare_forward:
    relevant_pt_layers = model.bert.encoder.layer
else:
    relevant_pt_layers = model.bert.encoder.layer #+ [model.bert.pooler] + [model.classifier]

print(layers_to_compare)
for layer_id, (_, bert_layer) in enumerate(layers_to_compare):
    if compare_forward:
        bert_layer.register_forward_hook(get_activation(f'{layer_id}.{type(bert_layer)}'))
    else:
        bert_layer.register_full_backward_hook(get_activation(f'{layer_id}.{type(bert_layer)}'))

