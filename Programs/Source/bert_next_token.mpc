"""
BERT Next Token Prediction with MPC in MP-SPDZ

This program:
1. Loads a pre-trained BERT model for masked language modeling
2. Converts BERT MLM to MP-SPDZ representation
3. Runs the encoder in MPC on secret-shared embeddings
4. Compares MPC results with PyTorch ground truth

Note that we do not implement the tokenizer in MPC (MP-SPDZ does not support strings), so we reveal the token ID instead of the string.

"""

import ml
import torch
import torch.nn as nn
from transformers import BertForMaskedLM, BertTokenizer

# ============================================================================
# Configuration
# ============================================================================

MODEL_NAME = 'prajjwal1/bert-small'  # Tiny BERT (2 layers, 128 hidden)
MAX_LENGTH = 16
# Example sentences with [MASK] token
EXAMPLES = [
    "Paris is the [MASK] of France.",
    "I like to [MASK] books.",
    "Birds [MASK] in the sky.",
]
N_SAMPLES = len(EXAMPLES)
BATCH_SIZE = N_SAMPLES # Process all samples in one batch so we can get argmax easily

# ============================================================================
# Model Loading
# ============================================================================

print(f"Loading model: {MODEL_NAME}")
tokenizer = BertTokenizer.from_pretrained(MODEL_NAME)
model = BertForMaskedLM.from_pretrained(MODEL_NAME)
model.eval()

print(f"Model: {model.config.num_hidden_layers} layers, {model.config.hidden_size} hidden")

# ============================================================================
# Tokenize Examples
# ============================================================================

print("\nTokenizing examples:")
tokenized_examples = []
mask_positions = []

for example in EXAMPLES[:N_SAMPLES]:
    encoded = tokenizer(example, truncation=True, padding='max_length',
                        max_length=MAX_LENGTH, return_tensors='pt')

    mask_token_id = tokenizer.mask_token_id
    mask_pos = (encoded['input_ids'][0] == mask_token_id).nonzero(as_tuple=True)[0]

    if len(mask_pos) > 0:
        mask_positions.append(mask_pos[0].item())
    else:
        mask_positions.append(1)

    tokenized_examples.append(encoded)
    print(f"  '{example}' (mask at position {mask_positions[-1]})")

# ============================================================================
# PyTorch Ground Truth
# ============================================================================

print("\nPyTorch predictions:")
pt_predictions = []
pt_tokens = []
pt_encoder_outputs = []

with torch.no_grad():
    for i, encoded in enumerate(tokenized_examples):
        # Get embeddings
        input_ids = encoded["input_ids"]
        token_type_ids = encoded.get("token_type_ids", torch.zeros_like(input_ids))
        embeddings = model.bert.embeddings(input_ids, token_type_ids=token_type_ids)

        # Run encoder
        encoder_output = model.bert.encoder(embeddings)[0]
        pt_encoder_outputs.append(encoder_output)

        # Run MLM head
        mlm_logits = model.cls(encoder_output)

        mask_pos = mask_positions[i]
        mask_logits = mlm_logits[0, mask_pos, :]
        predicted_id = torch.argmax(mask_logits).item()
        predicted_token = tokenizer.decode([predicted_id])

        pt_predictions.append(predicted_id)
        pt_tokens.append(predicted_token)

        sentence_with_pred = EXAMPLES[i].replace('[MASK]', f'**{predicted_token}**')
        print(f"  Sample {i}: {sentence_with_pred}")


from torchinfo import summary
summary(model.cls, input_size=encoder_output.shape)

# ============================================================================
# Prepare Embeddings for MPC
# ============================================================================

print("\nEmbedding inputs for MPC...")
embeddings_list = []

for encoded in tokenized_examples:
    input_ids = encoded["input_ids"]
    token_type_ids = encoded.get("token_type_ids", torch.zeros_like(input_ids))
    embedding = model.bert.embeddings(input_ids, token_type_ids=token_type_ids).detach()
    embeddings_list.append(embedding)

all_embeddings = torch.cat(embeddings_list, dim=0)
print(f"Embeddings shape: {all_embeddings.shape}")

# ============================================================================
# MP-SPDZ Model Conversion
# ============================================================================

class BertMLM(nn.Module):
    """BERT encoder wrapper for MP-SPDZ."""

    def __init__(self, encoder, mlm, config):
        super().__init__()
        self.encoder = encoder
        self.mlm = mlm
        self.config = config

    def forward(self, hidden_states, attention_mask=None):
        encoder_outputs = self.encoder(hidden_states, attention_mask=attention_mask)
        cls_outputs = self.mlm(encoder_outputs[0])
        return cls_outputs

print("\nConverting BERT encoder to MP-SPDZ...")
embeddings_sfix = sfix.input_tensor_via(0, all_embeddings.numpy())

# bert_encoder = BertEncoderOnly(model.bert.encoder, model.config)
bert_encoder = BertMLM(model.bert.encoder, model.cls, model.config)
mpc_layers = ml.layers_from_torch(bert_encoder, embeddings_sfix.shape,
                                  input_via=0, batch_size=BATCH_SIZE)
print(f"MP-SPDZ model: {len(mpc_layers)} layers")

# ============================================================================
# MP-SPDZ Inference
# ============================================================================

print("\nRunning MP-SPDZ inference...")

sfix.round_nearest = False
program.use_trunc_pr = False

# Create optimizer
optimizer = ml.SGD(mpc_layers)

print_ln("\n=== BERT Next Token Prediction (MPC) ===")
print_ln("Model: %s", MODEL_NAME)
print_ln("Samples: %s", N_SAMPLES)

# Prepare ground truth encoder outputs for comparison
pt_encoder_concat = torch.cat(pt_encoder_outputs, dim=0)
pt_encoder_sfix = sfix.input_tensor_via(0, pt_encoder_concat.numpy())

print_ln("\nRunning MPC forward pass through BERT encoder...")
print_ln("Input embeddings are SECRET-SHARED across parties")

# Run MPC forward pass - this actually runs BERT in MPC!
n_correct, loss = optimizer.reveal_correctness(embeddings_sfix, pt_encoder_sfix, batch_size=BATCH_SIZE)

print_ln("\n=== MPC Encoder Output ===")
print_ln("BERT encoder successfully ran in MPC!")
print_ln("Reveal correctness - n_correct: %s, loss: %s", n_correct, loss)

# Get MPC encoder output from the model
mpc_encoder_output = mpc_layers[-2].Y

# ============================================================================
# Apply MLM Head to MPC Output
# ============================================================================

print_ln("\n=== Applying MLM Head for Token Predictions ===")

# Reveal the MPC encoder output to apply the vocabulary head
# (The 30k vocab head is too expensive to run fully in MPC)

print_ln("\n=== MPC Encoder Complete ===")
print_ln("BERT encoder successfully executed in MPC!")
print_ln("Encoder output is secret-shared across parties")
print_ln("MPC output shape: %s", mpc_encoder_output.sizes)

# ============================================================================
# Verify MPC Output Matches PyTorch
# ============================================================================

print_ln("\n=== Verifying MPC Correctness ===")

# Apply MLM head to MPC output
# We need to reveal the MPC output and apply the MLM head
print_ln("\n=== Revealing MPC encoder output ===")

# Get the output from the encoder layer and reveal it
revealed_output = mpc_encoder_output.reveal()
print_ln("\n=== Applying Transform Head in MPC ===")

# Process each sample individually through the MLM head
# We need to do this one at a time because batch_size=1 in the MPC encoder
predicted_idx = []

for sample_idx in range(N_SAMPLES):
    mask_pos = mask_positions[sample_idx]
    sec_argmax = ml.argmax(mpc_encoder_output[sample_idx][mask_pos])
    predicted_idx.append(sec_argmax.reveal())

    print_ln("Sample %s in position %s predicts token id %s", sample_idx, mask_pos, sec_argmax.reveal())

print_ln("\n=== All Samples Processed ===")

# Use PyTorch's Tokenizer to show the actual words, since we do not implement the tokenizer in MPC.
print_ln("\n=== Decoded Predictions ===")
with torch.no_grad():
    for i in range(N_SAMPLES):
        # Use the PyTorch decoder to get token text
        mlm_logits = model.cls(pt_encoder_concat)
        mask_pos = int(mask_positions[i])
        mask_logits = mlm_logits[i, mask_pos, :]
        predicted_id = torch.argmax(mask_logits).item()
        predicted_token = tokenizer.decode([predicted_id])
        matches_spdz_output = predicted_idx[i] == predicted_id

        sentence_with_pred = EXAMPLES[i].replace('[MASK]', f'**{predicted_token}**')
        print_ln("  %s (%s, match=%s): %s", i, predicted_id, matches_spdz_output, sentence_with_pred)

print_ln("\n=== Complete ===")

